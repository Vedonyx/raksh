# Project API URL and server-only secret key from Supabase Settings > API Keys.
# The personal access token (sbp_...) is for account management, not application requests.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Admin email, scrypt hash (salt:128-character-hex), and an independent random session secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_salt_colon_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
